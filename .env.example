# Copy to .env and fill in, or run scripts/init-env.sh to fill the local secrets randomly.
# Never commit .env or real secrets.

# Backend
APP_ENV=development
# debug, info, warn or error; logs are JSON on stdout
LOG_LEVEL=info
HTTP_ADDR=:8080
# Relative to the server working directory; use ../web/dist when running from backend/.
WEB_DIST_DIR=web/dist
APP_ORIGIN=http://localhost:8080
# DSN of the metadata database (host "metadata-postgres" inside Compose, localhost:15432 from the host)
METADATA_DATABASE_URL=
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s
# true in production; false only for plain-HTTP local development
COOKIE_SECURE=false
# first admin, read only by `cmd/seed admin` (password may be piped with --password-stdin instead)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Development/test seed; copy tests/fixtures/connections.example.json to an ignored local file.
FIXTURE_PASSWORD=
FIXTURE_CONNECTIONS_FILE=

# Job queue (NATS JetStream). Compose services use nats://nats:4222.
NATS_URL=nats://localhost:14222
# relay (API): how often unpublished outbox rows are checked
OUTBOX_POLL_INTERVAL=500ms
# SSE keep-alive comment interval
SSE_HEARTBEAT_INTERVAL=15s

# Worker (cmd/worker); WORKER_ID defaults to the host name
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL=5s
# a job is redelivered when its worker stops reporting progress for this long
JOB_ACK_WAIT=60s
JOB_LOCK_RETRY_MAX_DELAY=30s
ORDERING_DELAY=1s
# retries after transient target failures: full-jitter backoff between base and max
MIGRATION_MAX_ATTEMPTS=3
MIGRATION_RETRY_BASE_DELAY=2s
MIGRATION_RETRY_MAX_DELAY=30s
MIGRATION_STATEMENT_TIMEOUT=30m
MIGRATION_LOCK_TIMEOUT=5s

# Telemetry (OpenTelemetry). Traces print to stdout ("console") by default; "otlp"
# sends traces and logs to the collector of the observability profile.
OTEL_TRACES_EXPORTER=console
OTEL_LOGS_EXPORTER=none
# "prometheus" serves /metrics on OTEL_EXPORTER_PROMETHEUS_PORT; an API and a worker
# on one host need different ports (or "none" for one of them).
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_HOST=localhost
OTEL_EXPORTER_PROMETHEUS_PORT=9464
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Connections and targets
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`
CONNECTION_ENCRYPTION_KEY=
# absolute directory that holds SQLite target files (/data/sqlite inside Compose)
SQLITE_TARGET_DIR=
TARGET_CONNECT_TIMEOUT=5s
TARGET_QUERY_TIMEOUT=10s

# Schema diff
ATLAS_BIN=
DIFF_TIMEOUT=30s

# --- frontend (public; never put secrets in VITE_*) ---
VITE_API_BASE_URL=/api/v1

# --- tests ---
# scripts/test-backend.sh runs in a container: use host.docker.internal:15432 / :15433 here.
# The target DSN uses the platform_runner role, e.g.
# postgres://platform_runner:<TARGET_RUNNER_PASSWORD>@host.docker.internal:15433/demo?sslmode=disable
TEST_METADATA_DATABASE_URL=
TEST_TARGET_DATABASE_URL=

# --- Compose-only (infra/docker/compose.yml) ---
METADATA_DB_PASSWORD=
TARGET_ADMIN_PASSWORD=
TARGET_RUNNER_PASSWORD=
