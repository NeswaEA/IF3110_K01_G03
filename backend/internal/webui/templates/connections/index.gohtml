{{define "content"}}
<section data-widget="connections" aria-live="polite">
{{if .Data.Rows}}
<div class="scroll-x">
<table>
<thead><tr><th scope="col">Nama</th><th scope="col">Driver</th><th scope="col">Target</th><th scope="col">Status</th></tr></thead>
<tbody>
{{range .Data.Rows}}<tr><td>{{.Name}}</td><td>{{.Driver}}</td><td>{{.Target}}</td><td>{{.Status}}</td></tr>
{{end}}
</tbody>
</table>
</div>
<p>Menampilkan koneksi {{.Data.First}} sampai {{.Data.Last}}.</p>
{{else if .Data.Prev}}
<p>Tidak ada koneksi pada halaman ini.</p>
{{else}}
<p>Belum ada koneksi terdaftar.</p>
{{end}}
<nav class="pager" aria-label="Halaman koneksi">
{{if .Data.Prev}}<a href="/admin/connections">Halaman pertama</a><a href="{{.Data.Prev}}">Sebelumnya</a>{{end}}
{{if .Data.Next}}<a href="{{.Data.Next}}">Berikutnya</a>{{end}}
</nav>
<noscript><p>Formulir tambah, ubah, uji, dan nonaktifkan koneksi memerlukan JavaScript.</p></noscript>
</section>
{{end}}
