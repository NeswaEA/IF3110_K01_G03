{
  "uid": "migration-queue",
  "title": "Migration queue",
  "description": "Antrian job migration, lock, durasi, batch, dan retry. Klik exemplar untuk membuka trace.",
  "tags": [
    "dbplatform"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "Jobs aktif per status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (migration_jobs)",
          "legendFormat": "{{status}}",
          "exemplar": false,
          "refId": "{{status}}"
        }
      ],
      "description": "Dari metadata (diekspos API): queued, held, running, outcome_unknown.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "title": "Job selesai per status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(migration_jobs_finished_total[5m])) * 60",
          "legendFormat": "{{status}}",
          "exemplar": false,
          "refId": "{{status}}"
        }
      ],
      "description": "Job per menit.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "id": 2
    },
    {
      "title": "Queue wait (enqueue sampai claim pertama)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(migration_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "exemplar": true,
          "refId": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(migration_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "exemplar": true,
          "refId": "p95"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "id": 3
    },
    {
      "title": "Lock wait",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le,driver) (rate(migration_lock_wait_seconds_bucket[5m])))",
          "legendFormat": "p50 {{driver}}",
          "exemplar": true,
          "refId": "p50 {{driver}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,driver) (rate(migration_lock_wait_seconds_bucket[5m])))",
          "legendFormat": "p95 {{driver}}",
          "exemplar": true,
          "refId": "p95 {{driver}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
