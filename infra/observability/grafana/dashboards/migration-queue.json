          "legendFormat": "p50 {{action}}",
          "exemplar": true,
          "refId": "p50 {{action}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,action) (rate(migration_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{action}}",
          "exemplar": true,
