      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (scenario) (k6_http_req_duration_p50)",
          "legendFormat": "p50 {{scenario}}",
          "exemplar": false,
