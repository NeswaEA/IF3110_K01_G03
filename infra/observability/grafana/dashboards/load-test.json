{
  "uid": "load-test",
  "title": "Load test (k6)",
  "description": "Metrik k6 lewat Prometheus remote write; bandingkan dengan dashboard Migration queue.",
  "tags": [
    "dbplatform"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "Virtual users",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": "VU",
          "exemplar": false,
          "refId": "VU"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "title": "Request per detik",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (rate(k6_http_reqs_total[30s]))",
          "legendFormat": "{{scenario}}",
          "exemplar": false,
          "refId": "{{scenario}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 8,
        "y": 0
      },
      "id": 2
    },
    {
      "title": "Request gagal",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (scenario) (k6_http_req_failed_rate)",
          "legendFormat": "{{scenario}}",
          "exemplar": false,
          "refId": "{{scenario}}"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
        "y": 0
      },
      "id": 3
    },
